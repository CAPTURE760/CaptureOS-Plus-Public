# 生产环境变量模板
# 复制为 .env.prod 并填入实际值（.env.prod 不会被 git 追踪）

# ===== 阿里云 ACR 镜像地址 =====
# 直接用 push.sh 推送的地址，latest 跟随最新版本
BACKEND_IMAGE=registry.example.com/captureos/captureos-backend:latest
FRONTEND_IMAGE=registry.example.com/captureos/captureos-frontend:latest
# 如需固定版本，把 latest 换成 v1.x（push.sh 会同时打两个标签）

# ===== 数据库 =====
POSTGRES_PASSWORD=改成强密码_至少16位含大小写数字符号

# ===== 公网访问地址 =====
# 替换成你服务器的公网 IP 或域名（带端口）
# 例1（IP）:  http://123.45.67.89:3000
# 例2（域名）: https://captureos.example.com
SERVER_PUBLIC_URL=http://你的服务器公网IP:3000

# CORS 白名单：后端允许跨域的来源
# 多个用逗号分隔，JSON 数组格式的字符串
CORS_ORIGINS=["http://你的服务器公网IP:3000","http://你的服务器公网IP:8001"]

# 前端调用后端的地址（用户浏览器里实际请求的后端）
NEXT_PUBLIC_API_URL=http://你的服务器公网IP:8001/api
