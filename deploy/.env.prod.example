# 生产环境变量模板
# 复制为 .env.prod 并填入实际值（.env.prod 不会被 git 追踪）

# ===== 阿里云 ACR 镜像地址 =====
# 直接用 push.sh 推送的地址，latest 跟随最新版本
BACKEND_IMAGE=registry.example.com/captureos/captureos-backend:latest
FRONTEND_IMAGE=registry.example.com/captureos/captureos-frontend:latest
# 如需固定版本，把 latest 换成 v1.x（push.sh 会同时打两个标签）

# ===== 数据库密码 =====
POSTGRES_PASSWORD=改成强密码_至少16位含大小写数字符号

# 说明：
# - 域名 example.com、CORS、API 地址已在 docker-compose.prod.yml / nginx/example.com.conf 中配置好
# - 前端后端仅绑定 127.0.0.1，统一经宿主机 nginx 反代（同源，无跨域问题）
# - HTTPS 由 certbot 容器签发 Let's Encrypt 证书，证书绑定挂载到宿主机 ./certs 供 nginx 读取
