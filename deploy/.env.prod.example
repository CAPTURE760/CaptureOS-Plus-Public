# 生产环境变量模板
# 复制为 .env.prod 并填入实际值（.env.prod 不会被 git 追踪）

# ===== 域名 =====
# 你的域名，init.sh 用它生成 nginx 配置，deploy.sh 用它输出访问地址
DOMAIN=example.com

# ===== 镜像仓库（仅 prod.yml / deploy.sh 路径需要）=====
# 使用 push.sh 推送到的镜像仓库地址，latest 跟随最新版本
BACKEND_IMAGE=registry.example.com/captureos/captureos-backend:latest
FRONTEND_IMAGE=registry.example.com/captureos/captureos-frontend:latest
# 如需固定版本，把 latest 换成 v1.x（push.sh 会同时打两个标签）

# ===== 数据库密码 =====
POSTGRES_PASSWORD=改成强密码_至少16位含大小写数字符号

# ===== CORS =====
# 同源部署时基本用不到，仍建议填你的域名
CORS_ORIGINS='["https://example.com","https://www.example.com","http://localhost:3000","http://localhost:8001"]'

# ===== 多用户认证 =====
# JWT 签名密钥，务必改为长随机字符串（至少 32 位）
SECRET_KEY=改成至少32位的随机字符串_含大小写数字符号
# 管理员账号密码（init.sh 会自动创建/更新管理员）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成管理员强密码

# 说明：
# - nginx 配置由 init.sh 按 DOMAIN 从 nginx/captureos.conf 模板生成
# - 前端后端仅绑定 127.0.0.1，统一经宿主机 nginx 反代（同源，无跨域问题）
# - HTTPS 由 Cloudflare 提供（Flexible 模式），源站 nginx 仅监听 80 端口
# - frontend 用 3003 端口（避开服务器上已占用 3000 的服务）
# - SINGLE_USER_MODE=false 时启用多用户模式，需登录；本地开发默认 true 免登录
# - 不开放注册，仅管理员可通过 API 创建用户
